{
  "manifest_version": 3,
  "name": "TV Streaming Remote",
  "version": "1.5.53",
  "description": "TV-friendly Netflix navigation with global Clear/Backspace/Escape back handling, close confirmation, and confirmed Netflix window closing.",
  "host_permissions": [
    "https://www.netflix.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "player.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TV Streaming Remote"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "windows"
  ]
}
